+        std::cerr << "EXP2026003_PATCH_D7 imsi=" << m_imsi << " t=" << Simulator::Now().GetSeconds()
+                  << " cell=" << m_cellId << std::endl;
+    }
+    break;
+
     default:
         NS_FATAL_ERROR("unexpected event in state " << ToString(m_state));
         break;
